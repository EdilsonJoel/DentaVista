<?xml version="1.0" encoding="UTF-8"?>
<!-- DentaVista · @author EREJM (Everson Ricardo · Edilson Joel · Michael) -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Panel principal: menú lateral oscuro + área de contenido con capas
     para diálogos modales y notificaciones flotantes. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.dentavista.vista.MainController" fx:id="raiz" styleClass="app">

    <BorderPane>
        <left>
            <VBox styleClass="sidebar">
                <HBox styleClass="marca">
                    <ImageView fx:id="imgLogo" fitWidth="38" fitHeight="38" preserveRatio="true"/>
                    <VBox spacing="1">
                        <HBox>
                            <Label text="DentaVista" styleClass="marca-titulo"/>
                        </HBox>
                        <Label text="Gestión clínica dental" styleClass="marca-subtitulo"/>
                    </VBox>
                </HBox>

                <Label fx:id="secConsultorio" text="CONSULTORIO" styleClass="nav-seccion"/>
                <ToggleButton fx:id="navInicio" text="Inicio" styleClass="nav-item"/>
                <ToggleButton fx:id="navPacientes" text="Pacientes" styleClass="nav-item"/>
                <ToggleButton fx:id="navAgenda" text="Agenda" styleClass="nav-item"/>
                <ToggleButton fx:id="navMiOdontograma" text="Mi odontograma" styleClass="nav-item"/>
                <ToggleButton fx:id="navMisCitas" text="Mis citas" styleClass="nav-item"/>

                <Label fx:id="secConfiguracion" text="CONFIGURACIÓN" styleClass="nav-seccion"/>
                <ToggleButton fx:id="navTratamientos" text="Tratamientos y precios" styleClass="nav-item"/>
                <ToggleButton fx:id="navUsuarios" text="Usuarios" styleClass="nav-item"/>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox styleClass="tarjeta-usuario">
                    <HBox fx:id="tarjetaUsuario" spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label fx:id="lblUsuario" styleClass="nombre" wrapText="true"/>
                            <Label fx:id="lblRol" styleClass="rol" wrapText="true"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Button fx:id="btnTema" text="Tema" styleClass="boton-panel"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSalir" text="Salir" styleClass="boton-panel"/>
                    </HBox>
                </VBox>
                <Label fx:id="lblClinica" styleClass="clinica-pie" wrapText="true"/>
            </VBox>
        </left>
        <center>
            <StackPane fx:id="contenido" styleClass="contenido"/>
        </center>
    </BorderPane>

    <VBox fx:id="zonaToasts" spacing="10" alignment="TOP_RIGHT" pickOnBounds="false"
          StackPane.alignment="TOP_RIGHT" maxWidth="420" maxHeight="-Infinity" mouseTransparent="false">
        <padding><Insets top="18" right="18"/></padding>
    </VBox>
</StackPane>
