<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Acceso: a la izquierda la dentadura 3D girando (la "vitrina" del producto),
     a la derecha el formulario. -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dentavista.vista.LoginController" styleClass="app">

    <StackPane fx:id="escenario" styleClass="login-escenario" HBox.hgrow="ALWAYS">
        <VBox fx:id="textos" spacing="14" pickOnBounds="false" StackPane.alignment="TOP_LEFT">
            <padding><Insets top="54" left="60" right="40"/></padding>
            <HBox spacing="0">
                <Label text="DentaVista" styleClass="login-titulo"/>
            </HBox>
            <Label text="Gestión clínica dental con odontograma 3D." styleClass="login-lema" maxWidth="460"/>
        </VBox>
        <VBox fx:id="puntos" spacing="10" pickOnBounds="false" StackPane.alignment="BOTTOM_LEFT" maxHeight="-Infinity">
            <padding><Insets bottom="48" left="60"/></padding>
        </VBox>
    </StackPane>

    <VBox styleClass="login-panel" alignment="CENTER_LEFT">
        <!-- El formulario se reemplaza por "Crea tu contraseña" si la cuenta tiene una temporal. -->
        <VBox fx:id="formulario" spacing="16">
            <Label fx:id="lblTitulo" text="Bienvenido de nuevo" styleClass="login-bienvenida"/>
            <Label fx:id="lblClinica" styleClass="texto-tenue" wrapText="true"/>
            <Region minHeight="10"/>

            <Label text="USUARIO" styleClass="campo-rotulo"/>
            <TextField fx:id="txtUsuario" promptText="tu.usuario" styleClass="campo-grande"/>
            <Label text="CONTRASEÑA" styleClass="campo-rotulo"/>
            <PasswordField fx:id="txtClave" promptText="••••••••" styleClass="campo-grande" onAction="#ingresar"/>

            <Label fx:id="lblError" styleClass="login-error" visible="false" managed="false"/>

            <Button fx:id="btnIngresar" text="Ingresar" styleClass="primario,boton-grande" maxWidth="Infinity"
                    defaultButton="true" onAction="#ingresar"/>

            <Label text="¿Olvidaste tu contraseña? El administrador del consultorio puede restablecerla desde Usuarios."
                   styleClass="texto-tenue,texto-pequeno" wrapText="true"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="© 2026 DentaVista · EREJM · Proyecto académico UNAJ" styleClass="texto-tenue,texto-pequeno"/>
    </VBox>
</HBox>
